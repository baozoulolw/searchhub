# ============================================================
# webSearch 部署配置文件
# 复制为 .env 后按需修改： cp .env.example .env
# 本文件由 backend/src/main.ts 的 dotenv 自动加载（放在 backend/ 目录）
# ============================================================

# —— 服务端口：改这里即可一键切换整个前后端访问端口 ——
PORT=3000

# —— 管理接口保护密钥（可选）——
# 不设置则管理接口放开；设置后访问 /api/providers 等管理接口需带该 Key
# （前端「访问密钥」页面里有输入框可填，自动附加 X-Admin-Key 头）
#ADMIN_KEY=please_change_me

# —— 各搜索源 API Key（可选；也可在后端「搜索源管理」页面里填）——
#TAVILY_API_KEY=your_tavily_key
#DOUBAO_API_KEY=your_volcengine_ark_key
#BRAVE_API_KEY=your_brave_key
#EXA_API_KEY=your_exa_key
#BROWSERBASE_API_KEY=your_browserbase_key